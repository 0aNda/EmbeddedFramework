# 默认自动识别文本文件，仓库内统一存 LF
* text=auto

# C/C++/汇编/链接脚本等源码强制使用 LF
*.c        text eol=lf
*.h        text eol=lf
*.cpp      text eol=lf
*.hpp      text eol=lf
*.cc       text eol=lf
*.S        text eol=lf
*.s        text eol=lf
*.ld       text eol=lf
*.mk       text eol=lf
Makefile   text eol=lf
CMakeLists.txt text eol=lf

# 常见文本配置文件
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.txt      text eol=lf
*.md       text eol=lf
*.xml      text eol=lf
*.ini      text eol=lf

# 二进制文件不要做换行符转换
*.bin      binary
*.hex      binary
*.elf      binary
*.o        binary
*.a        binary
*.so       binary
*.lib      binary
*.exe      binary
*.png      binary
*.jpg      binary
*.zip      binary
*.tar      binary
*.gz       binary